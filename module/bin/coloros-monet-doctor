#!/system/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Read-only diagnostics for the ColorOS 17 MD3E semantic layer.
# No app/service restart and no overlay/theme mutation.

STATE_DIR=/data/adb/coloros-monet
REPORT_ROOT="$STATE_DIR/reports"
DOWNLOAD_ROOT=/sdcard/Download
MODDIR="${0%/*}/.."
SEMANTIC_MANIFEST="$MODDIR/payload/semantic-accent-manifest.tsv"
STAMP="$(date +%Y%m%d_%H%M%S 2>/dev/null)"
[ -n "$STAMP" ] || STAMP=unknown
WORK="$REPORT_ROOT/ColorOS17_MD3E_Doctor_$STAMP"
SUMMARY="$WORK/SUMMARY.txt"

say() { printf '%s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

capture() {
    output="$1"
    shift
    {
        printf '$'
        for arg in "$@"; do printf ' %s' "$arg"; done
        printf '\n'
        "$@"
        rc=$?
        printf '\nexit_code=%s\n' "$rc"
    } > "$output" 2>&1
}

sha256_file() {
    file="$1"
    if have sha256sum; then
        sha256sum "$file" 2>/dev/null
    elif have toybox; then
        toybox sha256sum "$file" 2>/dev/null
    elif have busybox; then
        busybox sha256sum "$file" 2>/dev/null
    else
        printf 'sha256_unavailable  %s\n' "$file"
    fi
}

if [ "$(id -u 2>/dev/null)" != 0 ]; then
    say "[错误] 需要 Root 权限。"
    exit 1
fi

mkdir -p "$WORK" "$DOWNLOAD_ROOT" || exit 1

say "[1/6] 读取设备 / ColorOS / Monet 基线"
{
    echo "time=$(date '+%F %T %z' 2>/dev/null)"
    echo "model=$(getprop ro.product.model 2>/dev/null)"
    echo "device=$(getprop ro.product.device 2>/dev/null)"
    echo "sdk=$(getprop ro.build.version.sdk 2>/dev/null)"
    echo "release=$(getprop ro.build.version.release 2>/dev/null)"
    echo "display=$(getprop ro.build.display.id 2>/dev/null)"
    echo "oplusrom=$(getprop ro.build.version.oplusrom 2>/dev/null)"
    echo "fingerprint=$(getprop ro.build.fingerprint 2>/dev/null)"
    echo "selinux=$(getenforce 2>/dev/null)"
    echo "material_blur=$(getprop persist.sys.oplus.material_blur_switch 2>/dev/null)"
    echo "sf_background_blur=$(getprop ro.surface_flinger.supports_background_blur 2>/dev/null)"
    echo "theme_json=$(settings get secure theme_customization_overlay_packages 2>/dev/null)"
} > "$WORK/device_theme.txt"

say "[2/6] 读取模块配置"
{
    [ -f "$MODDIR/module.prop" ] && cat "$MODDIR/module.prop"
    echo
    echo "--- config ---"
    cat "$STATE_DIR/config.conf" 2>/dev/null
    echo
    echo "--- semantic manifest ---"
    cat "$SEMANTIC_MANIFEST" 2>/dev/null
} > "$WORK/module_state.txt"

say "[3/6] 检查 semantic overlays"
: > "$WORK/semantic_packages.txt"
if [ -f "$SEMANTIC_MANIFEST" ]; then
    TAB=$(printf '\t')
    while IFS="$TAB" read -r key target overlay apk count; do
        case "$key" in ''|'#'*) continue ;; esac
        [ "$key" = key ] && continue
        {
            echo "===== $key ====="
            echo "target=$target"
            echo "overlay=$overlay"
            echo "apk=$apk"
            echo "entry_count=$count"
            echo "--- target path ---"
            pm path "$target" 2>&1
            echo "--- overlay path ---"
            pm path "$overlay" 2>&1
            echo "--- overlay state ---"
            cmd overlay list --user 0 2>/dev/null | grep -F "$overlay" || true
            echo "--- overlay dump ---"
            cmd overlay dump "$overlay" 2>&1 | head -n 160
            echo
        } >> "$WORK/semantic_packages.txt"
    done < "$SEMANTIC_MANIFEST"
else
    echo "semantic_manifest_missing=1" >> "$WORK/semantic_packages.txt"
fi

say "[4/6] 检查关键资源最终解析"
{
    for spec in \
        'com.android.settings com.android.settings:color/coui_color_primary_blue' \
        'com.android.settings com.android.settings:color/coui_color_primary_text_blue' \
        'com.android.systemui com.android.systemui:color/coui_color_primary_blue' \
        'com.android.launcher com.android.launcher:color/coui_color_primary_blue' \
        'com.oplus.wirelesssettings com.oplus.wirelesssettings:color/coui_color_primary_blue' \
        'com.oplus.notificationmanager com.oplus.notificationmanager:color/coui_color_primary_blue'
    do
        target="$(printf '%s' "$spec" | cut -d' ' -f1)"
        res="$(printf '%s' "$spec" | cut -d' ' -f2)"
        echo "===== $res ====="
        if have timeout; then
            timeout 5 cmd overlay lookup --verbose "$target" "$res" 2>&1
        else
            cmd overlay lookup --verbose "$target" "$res" 2>&1
        fi
        echo
    done
} > "$WORK/resource_lookup.txt"

say "[5/6] 检查 idmap / OverlayManager / 近期异常"
capture "$WORK/overlay_list.txt" cmd overlay list --user 0
{
    find /data/resource-cache -type f 2>/dev/null | grep -Ei 'colorosmonet\.semantic|zhanfg.*semantic' | sort
} > "$WORK/idmap_paths.txt"
if have idmap2; then
    while IFS= read -r idmap; do
        [ -f "$idmap" ] || continue
        safe="$(basename "$idmap" | tr '/ :' '___')"
        capture "$WORK/idmap2_$safe.txt" idmap2 dump --idmap-path "$idmap"
    done < "$WORK/idmap_paths.txt"
fi
{
    logcat -b all -d -v threadtime 2>/dev/null | grep -Ei \
        'OverlayManager|idmap|colorosmonet\.semantic|Resources\$NotFoundException|ResourcesNotFoundException|FATAL EXCEPTION' | tail -n 8000
} > "$WORK/logcat_relevant.txt"

say "[6/6] 生成摘要并打包"
{
    echo "ColorOS 17 MD3E semantic-layer read-only diagnostic"
    echo "time=$(date '+%F %T %z' 2>/dev/null)"
    echo "sdk=$(getprop ro.build.version.sdk 2>/dev/null)"
    echo "build=$(getprop ro.build.display.id 2>/dev/null)"
    echo "semantic_manifest_present=$([ -f "$SEMANTIC_MANIFEST" ] && echo 1 || echo 0)"
    echo "safety=READ_ONLY_NO_RESTART_NO_THEME_MUTATION"
    echo "work_directory=$WORK"
    echo
    echo "Important:"
    echo "- non-EXPRESSIVE theme style is not an error;"
    echo "- this diagnostic does not change theme_customization_overlay_packages;"
    echo "- inspect semantic_packages/resource_lookup/idmap outputs together."
} > "$SUMMARY"
cat "$SUMMARY"

ARCHIVE="$DOWNLOAD_ROOT/ColorOS17_MD3E_Doctor_$STAMP.tar.gz"
if tar -czf "$ARCHIVE" -C "$REPORT_ROOT" "$(basename "$WORK")" 2>/dev/null; then
    sha256_file "$ARCHIVE" > "$ARCHIVE.sha256"
    chmod 0644 "$ARCHIVE" "$ARCHIVE.sha256" 2>/dev/null
    say "[完成] $ARCHIVE"
else
    say "[警告] 压缩失败，原始目录：$WORK"
    exit 2
fi
